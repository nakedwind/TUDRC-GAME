#!/bin/sh
# ===== commit 前的素材遺失檢查（tools/check-assets.py）=====
# 這次 commit 如果讓地圖用到的素材從素材庫消失、或素材圖檔沒加進 git，就先擋下來。
# 每台電腦要啟用一次：雙擊 tools/啟用commit檢查.bat（或執行 git config core.hooksPath .githooks）
# 確定要照樣 commit：git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 0
for py in python python3 py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys" >/dev/null 2>&1; then
    exec "$py" -X utf8 tools/check-assets.py --staged
  fi
done
echo "（提醒）找不到 Python，這次沒有做素材遺失檢查。"
exit 0
